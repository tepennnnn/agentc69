# Optional: defaults work without this file.
# Web: copy to .env.local and restart Next.
# CLI: export these variables in your shell; scripts do not load .env.local.

# Use the SAME absolute path for UI and CLI. Leave unset for <checkout>/workspace.
# AGENTCUT_WORKSPACE=/absolute/path/to/video-workspace

# Multilingual transcription model, downloaded on first use.
# AGENTCUT_WHISPER_MODEL=small

# Maximum requested video height for URL downloads.
# AGENTCUT_MAX_HEIGHT=720

# Optional additional media-shell tools for the clipping agent. Off by default.
# AGENTCUT_AGENT_SHELL=1

# Optional image providers for templates and the online asset search. Everything
# works without them: brand logos, Wikimedia Commons and Openverse need no key.

# Stock photography. Free key: https://www.pexels.com/api/
# AGENTCUT_PEXELS_KEY=

# Stock photography. Free key: https://unsplash.com/developers
# AGENTCUT_UNSPLASH_KEY=

# Google CSE and paid publishing services are disabled in this local clone.
# Local speech runtime overrides (normally configured in Assets > Voice-over):
# AGENTCUT_CHATTERBOX_PYTHON=C:/path/to/venv/Scripts/python.exe
# AGENTCUT_CHATTERBOX_MODEL_DIR=C:/path/to/models/nano
# AGENTCUT_CHATTERBOX_DEVICE=auto
# Agent proofreading is optional; recognition itself stays local.
# AGENTCUT_TRANSCRIPT_POLISH=1

# Optional Google Flow generation bridge. These values may instead be saved under
# Settings > This machine. URLs must use HTTPS; the token is sent as a bearer token.
# AGENTCUT_N8N_GENERATE_URL=https://n8n.example.com/webhook/agentcut-generate
# AGENTCUT_N8N_STATUS_URL=https://n8n.example.com/webhook/agentcut-status
# AGENTCUT_N8N_CANCEL_URL=https://n8n.example.com/webhook/agentcut-cancel
# AGENTCUT_GENERATION_OUTPUT_HOSTS=objectstorage.ap-manila-1.oraclecloud.com
# AGENTCUT_N8N_TOKEN=
# AGENTCUT_GENERATION_MAX_BYTES=1073741824
